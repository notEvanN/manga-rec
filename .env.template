# Copy to .env.local for local development (never commit real values).

# Filled in automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk dashboard > API keys (publishable key is public, safe for the browser)
VITE_CLERK_PUBLISHABLE_KEY=

# These are NOT read from this file. They're set on the Convex deployment itself:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...   (only needed for the account-deletion webhook)
